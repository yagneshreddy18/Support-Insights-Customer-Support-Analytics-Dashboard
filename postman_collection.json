{
  "info": {
    "name": "Support Insights - Customer Support Analytics Dashboard API (2026)",
    "description": "Production-ready Postman collection covering Auth, Ticket Lifecycle, Admin Users, Categories, Analytics, and Notifications.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"John Test\",\n  \"email\": \"john@example.com\",\n  \"password\": \"password123\",\n  \"role\": \"Customer\"\n}"
            },
            "url": { "raw": "http://localhost:5000/api/v1/auth/register", "protocol": "http", "host": ["localhost"], "port": "5000", "path": ["api", "v1", "auth", "register"] }
          }
        },
        {
          "name": "Login (Admin)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@supportinsights.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": { "raw": "http://localhost:5000/api/v1/auth/login", "protocol": "http", "host": ["localhost"], "port": "5000", "path": ["api", "v1", "auth", "login"] }
          }
        },
        {
          "name": "Get Profile",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "http://localhost:5000/api/v1/auth/profile", "protocol": "http", "host": ["localhost"], "port": "5000", "path": ["api", "v1", "auth", "profile"] }
          }
        }
      ]
    },
    {
      "name": "Tickets",
      "item": [
        {
          "name": "Get All Tickets",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "http://localhost:5000/api/v1/tickets", "protocol": "http", "host": ["localhost"], "port": "5000", "path": ["api", "v1", "tickets"] }
          }
        },
        {
          "name": "Create Ticket",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"SSO login redirect failure\",\n  \"description\": \"Okta SAML assertion error on login callback endpoint\",\n  \"category_id\": 3,\n  \"priority\": \"Critical\"\n}"
            },
            "url": { "raw": "http://localhost:5000/api/v1/tickets", "protocol": "http", "host": ["localhost"], "port": "5000", "path": ["api", "v1", "tickets"] }
          }
        },
        {
          "name": "Assign Ticket",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"assigned_agent_id\": 2\n}"
            },
            "url": { "raw": "http://localhost:5000/api/v1/tickets/2/assign", "protocol": "http", "host": ["localhost"], "port": "5000", "path": ["api", "v1", "tickets", "2", "assign"] }
          }
        },
        {
          "name": "Update Status",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"Resolved\",\n  \"resolution_notes\": \"Updated SSO certificate metadata and netmask policies.\"\n}"
            },
            "url": { "raw": "http://localhost:5000/api/v1/tickets/2/status", "protocol": "http", "host": ["localhost"], "port": "5000", "path": ["api", "v1", "tickets", "2", "status"] }
          }
        }
      ]
    },
    {
      "name": "Analytics",
      "item": [
        {
          "name": "Get Analytics Overview",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "http://localhost:5000/api/v1/analytics/overview", "protocol": "http", "host": ["localhost"], "port": "5000", "path": ["api", "v1", "analytics", "overview"] }
          }
        },
        {
          "name": "Get Employee Performance",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "http://localhost:5000/api/v1/analytics/employees", "protocol": "http", "host": ["localhost"], "port": "5000", "path": ["api", "v1", "analytics", "employees"] }
          }
        }
      ]
    }
  ]
}
